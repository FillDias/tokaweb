DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Gerar com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=

# Google Cloud Console
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# LINE Developers Console
NUXT_OAUTH_LINE_CLIENT_ID=
NUXT_OAUTH_LINE_CLIENT_SECRET=

# Apple em espera — exige conta de desenvolvedor paga (99 USD/ano).
# Enquanto vazio, o botão de Apple não aparece.
NUXT_OAUTH_APPLE_CLIENT_ID=
NUXT_OAUTH_APPLE_TEAM_ID=
NUXT_OAUTH_APPLE_KEY_ID=
NUXT_OAUTH_APPLE_PRIVATE_KEY=
